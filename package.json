{
  "name": "job-inspector-root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @job-inspector/sdk build && pnpm --filter @job-inspector/web build && pnpm --filter @job-inspector/server build",
    "dev:server": "pnpm --filter @job-inspector/server dev",
    "dev:worker": "pnpm --filter demo-worker worker",
    "start": "pnpm --filter @job-inspector/server start",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.1"
  }
}
