// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  FAILED
  DEAD_LETTER
  RESOLVED
}

model Job {
  id            String    @id @default(uuid())
  queueName     String    @map("queue_name")
  externalJobId String    @map("external_job_id")
  status        JobStatus @default(FAILED)

  // Denormalize for filtering without joining all the attempts
  lastErrorFingerprint String? @map("last_error_fingerprint")
  totalAttempts        Int     @default(1) @map("total_attempts")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  attempts JobAttempts[]

  @@unique([queueName, externalJobId])
  @@index([queueName])
  @@index([status])
  @@index([lastErrorFingerprint])
  @@map("jobs")
}

model JobAttempts {
  id            String @id @default(uuid())
  jobId         String @map("job_id")
  attemptNumber Int    @map("attempt_number")

  // ERROR INFORMATION...
  errorName          String  @map("error_name")
  errorMessage       String  @map("error_message")
  errorStack         String? @map("error_stack")
  errorFingerprint   String  @map("error_fingerprint")
  droppedBreadcrumbs Int? @map("dropped_breadcrumbs")
  // CONTEXT AND DIAGNOSTICS
  payload            Json? //JOB INPUT DATA 
  breadcrumbs        Json? // timestamps of https and db calls
  duration           Int?    @map("duration_ms")

  // failed
  failedAt DateTime @default(now()) @map("failed_at") @db.Timestamptz

  // relationship
  job Job @relation(references: [id], fields: [jobId], onDelete: Cascade)

  // making jobId and attemptNumbers unique as if network jitter and send the same error job twice it don't log twice
  @@unique([jobId, attemptNumber])
  
  @@index([jobId])
  @@index([failedAt])
  @@index([errorFingerprint, failedAt])
  @@map("job_attempts")
}
