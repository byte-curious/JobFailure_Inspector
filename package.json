{
  "name": "job-inspector-root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @morpheus.live/sdk build && pnpm --filter @morpheus.live/cli build && pnpm --filter @job-inspector/web build && pnpm --filter @job-inspector/server build",
    "test": "pnpm --filter @morpheus.live/sdk test && pnpm --filter @job-inspector/server test",
    "dev:server": "pnpm --filter @job-inspector/server dev",
    "dev:worker": "pnpm --filter example-basic-bullmq worker",
    "dev:web": "pnpm --filter @job-inspector/web dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.1"
  }
}
